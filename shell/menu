#!/usr/bin/env bash

[[ -f ~/.config/color_scheme ]] && source ~/.config/color_scheme

EXEC_DIR=~/programs
[[ -d "$1" ]] && EXEC_DIR="$1"


if pgrep -x wmenu; then
	pkill wmenu
else
	# there is probobly cleaner ways of doing this
	exec "$EXEC_DIR"/$(
		ls "$EXEC_DIR" | wmenu -c -l 5  \
		--bw 1 \
		-N $BG_PRIME \
		-n $TEXT_PRIME \
		-S $COLOR4 \
		-i
	)
fi
