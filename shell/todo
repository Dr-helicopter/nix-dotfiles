#!/usr/bin/env bash
#
# Write/remove a task to do later.
#
# Select an existing entry to remove it from the file, or type a new entry to
# add it.
#

if pgrep -x wmenu; then
	pkill wmenu
	exit 0
fi

[[ -f ~/.config/color_scheme ]] && source ~/.config/color_scheme

file="$HOME/.todo"
touch "$file"
height=$(wc -l "$file" | awk '{print $1}')
prompt="Add/delete a task: "

cmd=$( wmenu -c \
	--bw 1 \
	-N $BG_PRIME \
	-n $TEXT_PRIME \
	-S $COLOR4 \
	-l "$height" -p "$prompt" "$@" < "$file"
)
while [ -n "$cmd" ]; do
 	if grep -q "^$cmd\$" "$file"; then
		grep -v "^$cmd\$" "$file" > "$file.$$"
		mv "$file.$$" "$file"
        height=$(( height - 1 ))
 	else
		echo "$cmd" >> "$file"
		height=$(( height + 1 ))
 	fi

	cmd=$( wmenu -c \
		--bw 1 \
		-N $BG_PRIME \
		-n $TEXT_PRIME \
		-S $COLOR4 \
		-l "$height" -p "$prompt" "$@" < "$file"
	)
done

exit 0
